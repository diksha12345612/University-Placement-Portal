# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (put your database name before the "?")
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/placement_portal?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (resume storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail). EMAIL_PASS is a 16-character Google App Password, written without spaces.
# If these are empty in development, emails are printed in the terminal instead of being sent.
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your16charapppassword
EMAIL_FROM_NAME=Placement Portal

# AI (any OpenAI-compatible API). Default: OpenRouter, key from https://openrouter.ai/keys
# Pick a model id from https://openrouter.ai/models (free ones end with ":free")
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your_ai_api_key
AI_MODEL=model_id_here

# First admin account (used only by: npm run seed:admin)
ADMIN_NAME=Placement Officer
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeThisPassword123
